# CINEMATCH environment template — copy to `.env` (git-ignored) and fill in real values there.
# NEVER put a real key in this file: it is committed to Git (Constitution Principle IV).

# --- Application ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database ------------------------------------------------------------------
# Local and tests: leave the Supabase values empty; lib/db/ loads data/seed/*.csv into node:sqlite.
# Shared (preview/production): Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Language model (F-M3-11: extracts attributes only, never ranks) -------------
# mock   = rule-based extractor, no key needed (default for tests)
# gemini = Google Gemini API (key from Google AI Studio)
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Use a current Flash model name shown in Google AI Studio.
# Checked 30/10/2026: gemini-3.5-flash-lite answers in about 1 s; gemini-2.5-flash returns 404 for new keys;
# gemini-3.8-flash did not answer within 8 s.
# On a network error, a 429 or no answer within 8 s, the rule-based extractor answers instead
# and SC-15 shows "Đang dùng chế độ dự phòng" (lib/extraction/index.js).
GEMINI_MODEL=
# Real (confidential) scripts may only be sent when this is true AND the key is on a paid plan
# (spec-M5 Clarifications Q3). Keep false with free-tier keys.
GEMINI_PAID_TIER=false

# --- Local mock sign-in (until the SYS slice) ------------------------------------
# Role used when a request has no x-mock-role header (the header always wins).
# Dev only: ignored when NODE_ENV=production. Set vfda_staff to open /admin/locations (SC-35) in a browser.
# guest | member | partner | vfda_staff | vfda_legal | admin
MOCK_AUTH_DEFAULT_ROLE=guest
# Seed staff account acting for x-mock-role: vfda_staff (audit_log.admin_id, authority_contact.verified_by).
# Empty = 515529a9-46d9-559c-aab4-e5fb31eedeea (Nguyễn Thị Thu Hà); 74749444-a35e-5c4b-892b-2f8cb8cf80b9 = Lê Hoàng Phúc.
MOCK_STAFF_USER_ID=
