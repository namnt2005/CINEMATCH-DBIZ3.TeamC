# CINEMATCH Environment Configuration Template
# Copy this file to .env for local development

# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration (Supabase PostgreSQL / Local)
# In development/test without PostgreSQL, the local engine falls back to SQLite loaded from data/
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinematch
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-local

# Language Model API (F-M3-11: Extracted attributes only, never ranks locations)
# Provider choices pending team confirmation (Constitution Principle IV: no cloud secrets committed)
LLM_PROVIDER=mock
LLM_API_KEY=placeholder-llm-key
LLM_MODEL=placeholder-model

# Session Mock Role (For local development and testing: guest, member, vfda_staff)
MOCK_AUTH_DEFAULT_ROLE=guest
